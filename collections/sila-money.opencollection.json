          "http": {
            "method": "POST",
            "url": "https://api.silamoney.com/0.2/request_kyc",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "authsignature",
                "value": "{{authsignature}}"
              },
              {
                "name": "usersignature",
                "value": "{{usersignature}}"
              }
