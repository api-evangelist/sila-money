                "value": "{{authsignature}}"
              },
              {
                "name": "usersignature",
                "value": "{{usersignature}}"
              }
            ],
            "body": {
              "type": "json",
              "data": "{\n  \"header\": {\n    \"created\": 0,\n    \"app_handle\": \"{{appHandle}}\",\n    \"user_handle\": \"{{userHandle}}\"\n  }\n}"
            }
          },
          "docs": "Return current verification status. Requires authsignature + usersignature (businesssignature for KYB)."
        },
